{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*": ["../fe/src/constants/*"],
      "@pages/*": ["./src/pages/*"],
      "@shared/*": ["./src/shared/*"],
      "@types/*": ["./src/types/*"],
      "@api/*": ["./src/api/*"],
      "@routing/*": ["./src/routing/*"],
      "@config/*": ["../fe/src/config/*"],
      "@utils/*": ["../fe/src/utils/*"],
      "@stores/*": ["./src/stores/*"],
      "@apis/*": ["./src/api/apis/*"],
      "@apiTypes/*": ["./src/api/types/*"],
      "@messages/*": ["../fe/src/messages/*"],
      "@theme/*": ["./src/theme/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "build"]
}
