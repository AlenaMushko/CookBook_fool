# Copy to .env and change secrets before first run:
#   cp .env.example .env

WEB_PORT=80

# App
APP_PORT=3000
APP_HOST=0.0.0.0

# Postgres
POSTGRES_USER=cookbook
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=cookbook
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# JWT — use long random strings in real deployments
AUTH_ACCESS_TOKEN_SECRET=change_me_access_token_secret_min_32_chars
AUTH_REFRESH_TOKEN_SECRET=change_me_refresh_token_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=86400

# MinIO / S3 (server talks to minio service; browser uses nginx /storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=change_me_minio_password
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=cookbook
AWS_S3_ENDPOINT=http://minio:9000
