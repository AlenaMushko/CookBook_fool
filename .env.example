# Copy to .env and fill in values before first run:
#   cp .env.example .env

WEB_PORT=

# App
APP_PORT=
APP_HOST=
NODE_ENV=
# LOG_LEVEL=

# Postgres
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Used by Prisma (compose overrides POSTGRES_HOST=db for the app container)
DATABASE_URL=

# JWT — long random strings (min 32 chars in production)
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION=

# CORS — comma-separated browser origins (required for httpOnly cookies)
ALLOWED_ORIGINS=

# Auth cookies — omit to follow NODE_ENV (secure in production).
# Set "false" only for temporary HTTP (e.g. EB without ACM/HTTPS).
# COOKIE_SECURE=

# AWS (shared region for S3 + SES)
# Locally: set keys or use `aws configure` / AWS_PROFILE.
# On Elastic Beanstalk: omit keys — use the EC2 instance IAM role.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET_NAME=

FRONTEND_URL=

# Amazon SES — verify SES_FROM_EMAIL in AWS_REGION (sandbox: recipients must also be verified)
SES_FROM_EMAIL=
SES_FROM_NAME=

# Optional local-only: also seed demo users/recipes
# SEED_DEMO=true
