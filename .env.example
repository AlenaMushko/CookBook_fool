# Copy to .env and change secrets before first run:
#   cp .env.example .env

WEB_PORT=80

# App
APP_PORT=3000
APP_HOST=0.0.0.0
NODE_ENV=development
# LOG_LEVEL=debug

# Postgres
POSTGRES_HOST=localhost
POSTGRES_USER=cookbook
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=cookbook
POSTGRES_PORT=5432
# Used by Prisma (compose overrides POSTGRES_HOST=db for the app container)
DATABASE_URL=postgresql://cookbook:change_me_postgres@localhost:5432/cookbook?schema=public

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379
REDIS_HOST=localhost

# JWT — use long random strings in real deployments
AUTH_ACCESS_TOKEN_SECRET=change_me_access_token_secret_min_32_chars
AUTH_REFRESH_TOKEN_SECRET=change_me_refresh_token_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=86400
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION=3600

# CORS — comma-separated browser origins (required for httpOnly cookies)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# AWS (shared credentials + region for S3 + SES)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=cookbook

FRONTEND_URL=http://localhost:5173

# Amazon SES — verify SES_FROM_EMAIL in AWS_REGION
SES_FROM_EMAIL=
SES_FROM_NAME=Cookbook
