# Copy values into Elastic Beanstalk → Configuration → Software → Environment properties.
# Do NOT commit real secrets. Do NOT bake secrets into VITE_* build args.

# --- Images (used when composing deployment/docker-compose.yml) ---
ECR_REGISTRY=
IMAGE_TAG=

# --- App ---
NODE_ENV=
APP_HOST=
APP_PORT=

# --- Database (private RDS) ---
# Example: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL=

# --- JWT (min 32 chars each; never use defaults like “access secret”) ---
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION=

# --- Public URL of the app (EB CNAME until a custom domain exists) ---
FRONTEND_URL=
ALLOWED_ORIGINS=

# Auth cookies — "false" until ALB HTTPS; then "true" (or omit; production defaults to secure)
COOKIE_SECURE=

# --- AWS region / S3 (private bucket + presigned URLs) ---
AWS_REGION=
AWS_S3_REGION=
AWS_S3_BUCKET_NAME=

# On Elastic Beanstalk leave these empty — use the EC2 instance IAM role.
# Locally you may set them (or use an AWS profile) instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Amazon SES (sandbox: only verified identities can receive mail) ---
SES_FROM_EMAIL=
SES_FROM_NAME=
