{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "../dist/prisma",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["seed-catalogs.ts", "data/**/*.ts", "data/**/*.json"]
}
